# Long-Lived Access Token: Home Assistant -> Profil -> Sicherheit -> Langlebige Zugriffstoken
# (Die Herkunft der Änderungen braucht einen Administrator-Token; bei einem anderen läuft die Aufzeichnung weiter, aber ohne Herkunft.)
HA_TOKEN=hier-das-token-eintragen
# Adresse von Home Assistant (WebSocket)
HA_URL=ws://homeassistant.local:8123/api/websocket

# Ausführung der KI-Regeln (Dienst "execution")
# Eigener Long-Lived Access Token mit Schreibrechten (empfohlen: eigener HA-Benutzer "homeai", Administrator)
HA_WRITE_TOKEN=hier-den-schreibtoken-eintragen
# MQTT-Broker (derselbe, den Home Assistant nutzt)
MQTT_HOST=192.168.1.100
MQTT_PORT=1883
MQTT_USER=homeai
MQTT_PASSWORD=hier-das-passwort-eintragen

# Langfuse: Tracing und Prompt-Verwaltung der Analyse (leer lassen = aus)
# Projekt "heating-control" in Langfuse anlegen; die Adresse ist die von Langfuse angezeigte Basis-URL
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# optional: erscheint in Langfuse als Release (z. B. Git-Commit)
APP_VERSION=
